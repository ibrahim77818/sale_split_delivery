<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.split.delivery</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Outbound Logistics" name="sale_split_delivery_container">
                    <setting id="sale_split_delivery_setting"
                             help="Split delivery orders of confirmed sales orders by line delivery date, source location and/or warehouse.">
                        <field name="sale_split_delivery"/>
                        <div class="content-group" invisible="not sale_split_delivery">
                            <div class="mt16">
                                <field name="sale_split_by_date" class="oe_inline"/>
                                <label for="sale_split_by_date" class="o_light_label"/>
                            </div>
                            <div>
                                <field name="sale_split_by_location" class="oe_inline"/>
                                <label for="sale_split_by_location" class="o_light_label"/>
                            </div>
                            <div>
                                <field name="sale_split_by_warehouse" class="oe_inline"/>
                                <label for="sale_split_by_warehouse" class="o_light_label"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
