<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sale_split_delivery" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.split.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="sale_split_by_date_enabled" invisible="1"/>
                <field name="sale_split_by_location_enabled" invisible="1"/>
                <field name="sale_split_by_warehouse_enabled" invisible="1"/>
                <field name="locked" invisible="1"/>
            </xpath>

            <!-- Order lines: list -->
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="delivery_warehouse_id" optional="show"
                       options="{'no_create': True}"
                       domain="[('company_id', '=', parent.company_id)]"
                       column_invisible="not parent.sale_split_by_warehouse_enabled"
                       readonly="display_type or parent.state in ('sale', 'cancel')"/>
                <field name="delivery_location_id" optional="show"
                       options="{'no_create': True}"
                       column_invisible="not parent.sale_split_by_location_enabled"
                       readonly="display_type or parent.state == 'cancel' or parent.locked"/>
                <field name="expected_delivery_date" optional="show"
                       column_invisible="not parent.sale_split_by_date_enabled"
                       readonly="display_type or parent.state == 'cancel' or parent.locked"/>
            </xpath>

            <!-- Order lines: form (mobile / kanban editing) -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="delivery_warehouse_id"
                       options="{'no_create': True}"
                       domain="[('company_id', '=', parent.company_id)]"
                       invisible="display_type or not parent.sale_split_by_warehouse_enabled"
                       readonly="parent.state in ('sale', 'cancel')"/>
                <field name="delivery_location_id"
                       options="{'no_create': True}"
                       invisible="display_type or not parent.sale_split_by_location_enabled"
                       readonly="parent.state == 'cancel' or parent.locked"/>
                <field name="expected_delivery_date"
                       invisible="display_type or not parent.sale_split_by_date_enabled"
                       readonly="parent.state == 'cancel' or parent.locked"/>
            </xpath>
        </field>
    </record>
</odoo>
