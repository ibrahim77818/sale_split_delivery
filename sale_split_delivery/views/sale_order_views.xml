<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sale_split_delivery" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.split.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="sale_split_by_date_enabled" invisible="1"/>
                <field name="sale_split_by_location_enabled" invisible="1"/>
                <field name="sale_split_by_warehouse_enabled" invisible="1"/>
            </xpath>

            <!-- Order lines: list -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="delivery_warehouse_id" optional="show"
                       options="{'no_create': True}"
                       domain="[('company_id', '=', parent.company_id)]"
                       attrs="{'column_invisible': [('parent.sale_split_by_warehouse_enabled', '=', False)],
                               'readonly': ['|', ('display_type', '!=', False), ('parent.state', 'in', ('sale', 'done', 'cancel'))]}"/>
                <field name="delivery_location_id" optional="show"
                       options="{'no_create': True}"
                       attrs="{'column_invisible': [('parent.sale_split_by_location_enabled', '=', False)],
                               'readonly': ['|', ('display_type', '!=', False), ('parent.state', 'in', ('done', 'cancel'))]}"/>
                <field name="expected_delivery_date" optional="show"
                       attrs="{'column_invisible': [('parent.sale_split_by_date_enabled', '=', False)],
                               'readonly': ['|', ('display_type', '!=', False), ('parent.state', 'in', ('done', 'cancel'))]}"/>
            </xpath>

            <!-- Order lines: form (mobile / kanban editing) -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="delivery_warehouse_id"
                       options="{'no_create': True}"
                       domain="[('company_id', '=', parent.company_id)]"
                       attrs="{'invisible': ['|', ('display_type', '!=', False), ('parent.sale_split_by_warehouse_enabled', '=', False)],
                               'readonly': [('parent.state', 'in', ('sale', 'done', 'cancel'))]}"/>
                <field name="delivery_location_id"
                       options="{'no_create': True}"
                       attrs="{'invisible': ['|', ('display_type', '!=', False), ('parent.sale_split_by_location_enabled', '=', False)],
                               'readonly': [('parent.state', 'in', ('done', 'cancel'))]}"/>
                <field name="expected_delivery_date"
                       attrs="{'invisible': ['|', ('display_type', '!=', False), ('parent.sale_split_by_date_enabled', '=', False)],
                               'readonly': [('parent.state', 'in', ('done', 'cancel'))]}"/>
            </xpath>
        </field>
    </record>
</odoo>
